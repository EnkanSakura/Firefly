---
import { Icon } from "astro-icon/components";
import MarkdownEditor from "@components/tools/MarkdownEditor.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const title = "Markdown 编辑器";
const description = "支持 Firefly 主题特殊格式的在线 Markdown 编辑器，可导出 .md / .mdx 文件。";
---

<MainGridLayout title={title} description={description}>
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-6 py-6 md:px-9 md:py-6 relative w-full">
      <!-- 页面标题 -->
      <div class="mb-6">
        <div class="flex items-center gap-3 mb-3">
          <div class="h-8 w-8 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70">
            <Icon name="material-symbols:edit-note" class="text-[1.25rem]" />
          </div>
          <div class="text-2xl md:text-3xl font-bold text-neutral-900 dark:text-neutral-100">
            Markdown 编辑器
          </div>
        </div>
      </div>

      <!-- Markdown 编辑器组件 -->
      <MarkdownEditor />
    </div>
  </div>
</MainGridLayout>
