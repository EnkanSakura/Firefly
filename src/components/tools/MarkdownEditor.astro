---
// Firefly Markdown Editor — 支持 Firefly 主题特殊格式的在线编辑器
---

<!-- KaTeX CSS (load early to prevent FOUC) -->
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/katex@0.17.0/dist/katex.min.css"
  integrity="sha384-7Vg9pWB6bVWm3A0HyhO+U4oGJxdO5lRBbQghSg2S2MQFfRkbL6kW4hP1LK+a0u4"
  crossorigin="anonymous"
/>
<!-- Mermaid CSS -->
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.css"
/>

<!-- Dependencies: marked, highlight.js, KaTeX, Mermaid -->
<script is:inline src="/assets/js/marked.min.js"></script>
<script is:inline src="/assets/js/highlight.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/katex@0.17.0/dist/katex.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js"></script>

<!-- ==================== HTML 结构 ==================== -->
<div id="mde-root">
  <!-- 工具栏 -->
  <div class="mde-toolbar" id="mde-toolbar">
    <div class="mde-toolbar-group">
      <button class="mde-btn" data-cmd="bold" title="粗体 (Ctrl+B)"><strong>B</strong></button>
      <button class="mde-btn" data-cmd="italic" title="斜体 (Ctrl+I)"><em>I</em></button>
      <button class="mde-btn" data-cmd="strike" title="删除线"><s>S</s></button>
    </div>
    <div class="mde-toolbar-divider"></div>
    <div class="mde-toolbar-group">
      <button class="mde-btn" data-cmd="h1" title="标题 1">H1</button>
      <button class="mde-btn" data-cmd="h2" title="标题 2">H2</button>
      <button class="mde-btn" data-cmd="h3" title="标题 3">H3</button>
    </div>
    <div class="mde-toolbar-divider"></div>
    <div class="mde-toolbar-group">
      <button class="mde-btn" data-cmd="link" title="链接">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
      </button>
      <button class="mde-btn" data-cmd="image" title="图片">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
      </button>
    </div>
    <div class="mde-toolbar-divider"></div>
    <div class="mde-toolbar-group">
      <button class="mde-btn" data-cmd="code" title="行内代码">&lt;/&gt;</button>
      <button class="mde-btn" data-cmd="codeblock" title="代码块">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
      </button>
      <button class="mde-btn" data-cmd="mermaid" title="Mermaid 图表">⏣</button>
    </div>
    <div class="mde-toolbar-divider"></div>
    <div class="mde-toolbar-group">
      <button class="mde-btn" data-cmd="blockquote" title="引用">❝</button>
      <button class="mde-btn" data-cmd="ul" title="无序列表">•</button>
      <button class="mde-btn" data-cmd="ol" title="有序列表">1.</button>
    </div>
    <div class="mde-toolbar-divider"></div>
    <div class="mde-toolbar-group">
      <button class="mde-btn" data-cmd="table" title="表格">▦</button>
      <button class="mde-btn" data-cmd="hr" title="分割线">—</button>
    </div>
    <div class="mde-toolbar-divider"></div>
    <div class="mde-toolbar-group">
      <button class="mde-btn" data-cmd="katex" title="数学公式">Σ</button>
      <button class="mde-btn" data-cmd="admonition" title="提醒框">⚠</button>
    </div>
  </div>

  <!-- 视图切换 & 辅助按钮 -->
  <div class="mde-actions-row">
    <div class="mde-view-tabs">
      <div class="mde-view-group">
        <button class="mde-view-tab active" data-view="split">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><rect x="1" y="2" width="6" height="12" rx="1"/><rect x="9" y="2" width="6" height="12" rx="1"/></svg>
          分栏
        </button>
        <button class="mde-view-tab" data-view="edit">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><rect x="2" y="2" width="12" height="12" rx="1"/></svg>
          编辑
        </button>
        <button class="mde-view-tab" data-view="preview">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><rect x="2" y="2" width="12" height="12" rx="1"/></svg>
          预览
        </button>
      </div>
      <div class="mde-view-divider"></div>
      <button class="mde-dir-btn" id="mde-dir-toggle" title="切换分栏方向">
        <svg id="mde-dir-icon" width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><rect x="1" y="2" width="6" height="5" rx="1"/><rect x="1" y="9" width="6" height="5" rx="1"/><rect x="9" y="2" width="6" height="12" rx="1"/></svg>
      </button>
    </div>
    <div class="mde-actions-right">
      <!-- 示例按钮已移除 -->
      <button class="mde-action-btn" id="mde-clear-btn" title="清空编辑器">🗑 清空</button>
      <button class="mde-action-btn mde-action-btn--primary" id="mde-download-md" title="下载为 .md 文件">⬇ .md</button>
      <button class="mde-action-btn mde-action-btn--primary" id="mde-download-mdx" title="下载为 .mdx 文件">⬇ .mdx</button>
    </div>
  </div>

  <!-- 编辑器主体 -->
  <div class="mde-body split-horizontal" id="mde-body">
    <div class="mde-pane mde-pane-edit" id="mde-pane-edit">
      <textarea
        id="mde-textarea"
        class="mde-textarea"
        spellcheck="false"
      ></textarea>
    </div>
    <div class="mde-divider" id="mde-divider"></div>
    <div class="mde-pane mde-pane-preview" id="mde-pane-preview">
      <div class="mde-preview custom-md" id="mde-preview"></div>
    </div>
  </div>

  <!-- 底部状态栏 -->
  <div class="mde-footer">
    <span class="mde-stats" id="mde-stats">字数: 0 &nbsp;|&nbsp; 行数: 1</span>
    <span class="mde-status" id="mde-status">就绪</span>
  </div>
</div>

<style is:inline>
/* ========== 编辑器根容器 ========== */
#mde-root {
  --mde-border: #e5e7eb;
  --mde-border-hover: #d1d5db;
  --mde-bg: #ffffff;
  --mde-bg-secondary: #f9fafb;
  --mde-text: #1f2937;
  --mde-text-secondary: #6b7280;
  --mde-toolbar-bg: #f3f4f6;
  --mde-btn-hover: #e5e7eb;
  --mde-btn-active: #d1d5db;
  --mde-focus: var(--primary, #3b82f6);
  --mde-radius: 8px;
  font-family: inherit;
  color: var(--mde-text);
}

.dark #mde-root {
  --mde-border: #374151;
  --mde-border-hover: #4b5563;
  --mde-bg: #1f2937;
  --mde-bg-secondary: #111827;
  --mde-text: #f3f4f6;
  --mde-text-secondary: #9ca3af;
  --mde-toolbar-bg: #374151;
  --mde-btn-hover: #4b5563;
  --mde-btn-active: #6b7280;
}

/* ========== 工具栏 ========== */
.mde-toolbar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 2px;
  padding: 6px 8px;
  background: var(--mde-toolbar-bg);
  border: 1px solid var(--mde-border);
  border-radius: var(--mde-radius) var(--mde-radius) 0 0;
  user-select: none;
  overflow-x: auto;
}

.mde-toolbar-group {
  display: flex;
  gap: 1px;
}

.mde-toolbar-divider {
  width: 1px;
  height: 22px;
  background: var(--mde-border);
  margin: 0 4px;
  flex-shrink: 0;
}

.mde-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 30px;
  height: 30px;
  padding: 0 6px;
  border: none;
  border-radius: 4px;
  background: transparent;
  color: var(--mde-text);
  font-size: 13px;
  cursor: pointer;
  transition: background 0.15s;
  white-space: nowrap;
  font-family: inherit;
}

.mde-btn:hover { background: var(--mde-btn-hover); }
.mde-btn:active { background: var(--mde-btn-active); }
.mde-btn svg { display: block; }

/* ========== 操作行 ========== */
.mde-view-group {
  display: flex;
  gap: 2px;
}

.mde-view-divider {
  width: 1px;
  height: 18px;
  background: var(--mde-border);
  margin: 0 6px;
  flex-shrink: 0;
}

.mde-dir-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  padding: 0;
  border: none;
  border-radius: 4px;
  background: transparent;
  color: var(--mde-text-secondary);
  cursor: pointer;
  transition: all 0.15s;
}
.mde-dir-btn:hover { color: var(--mde-text); background: var(--mde-btn-hover); }

.mde-actions-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8px;
  padding: 8px;
  border-left: 1px solid var(--mde-border);
  border-right: 1px solid var(--mde-border);
  background: var(--mde-bg-secondary);
}

.mde-view-tabs {
  display: flex;
  gap: 2px;
  background: var(--mde-toolbar-bg);
  border-radius: 6px;
  padding: 2px;
  align-items: center;
}

.mde-view-tab {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 5px 12px;
  border: none;
  border-radius: 4px;
  background: transparent;
  color: var(--mde-text-secondary);
  font-size: 12px;
  cursor: pointer;
  transition: all 0.15s;
  font-family: inherit;
}

.mde-view-tab:hover { color: var(--mde-text); }
.mde-view-tab.active {
  background: var(--mde-bg);
  color: var(--mde-text);
  box-shadow: 0 1px 2px rgba(0,0,0,0.08);
}

.mde-actions-right {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
}

.mde-action-btn {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 5px 12px;
  border: 1px solid var(--mde-border);
  border-radius: 6px;
  background: var(--mde-bg);
  color: var(--mde-text);
  font-size: 12px;
  cursor: pointer;
  transition: all 0.15s;
  font-family: inherit;
}

.mde-action-btn:hover {
  border-color: var(--mde-border-hover);
  background: var(--mde-btn-hover);
}

.mde-action-btn--primary {
  background: oklch(from var(--primary, #3b82f6) l c h / 0.12);
  border-color: oklch(from var(--primary, #3b82f6) l c h / 0.3);
  color: var(--primary, #3b82f6);
}

.mde-action-btn--primary:hover {
  background: oklch(from var(--primary, #3b82f6) l c h / 0.2);
  border-color: var(--primary, #3b82f6);
}

/* ========== 编辑器主体 ========== */
.mde-body {
  display: flex;
  border-left: 1px solid var(--mde-border);
  border-right: 1px solid var(--mde-border);
  min-height: 420px;
  height: calc(100vh - 320px);
  max-height: 70vh;
}

/* 编辑窗格 */
.mde-pane {
  position: relative;
  overflow: hidden;
}

.mde-pane-edit {
  flex: 1;
  min-width: 0;
}

.mde-pane-preview {
  flex: 1;
  min-width: 0;
  overflow-y: auto;
  background: var(--mde-bg);
}

/* 分割线（可拖拽） */
.mde-divider {
  background: var(--mde-border);
  flex-shrink: 0;
  transition: background 0.15s;
  position: relative;
}

.mde-divider:hover,
.mde-divider:active {
  background: var(--mde-focus);
}

.mde-textarea {
  width: 100%;
  height: 100%;
  padding: 16px;
  border: none;
  outline: none;
  resize: none;
  background: var(--mde-bg);
  color: var(--mde-text);
  font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', monospace;
  font-size: 14px;
  line-height: 1.65;
  tab-size: 2;
  overflow-y: auto;
}

.mde-textarea::placeholder { color: var(--mde-text-secondary); }

/* ========== 预览区 ========== */
.mde-preview {
  padding: 16px;
  min-height: 100%;
}

.mde-preview :first-child { margin-top: 0; }

/* ========== 视图模式 ========== */
.mde-body.view-edit .mde-pane-preview,
.mde-body.view-edit .mde-divider { display: none; }
.mde-body.view-edit .mde-pane-edit { flex: 1; }

.mde-body.view-preview .mde-pane-edit,
.mde-body.view-preview .mde-divider { display: none; }
.mde-body.view-preview .mde-pane-preview { flex: 1; }

/* ========== 分栏方向 ========== */
/* 横向分栏（默认） */
.mde-body.split-horizontal { flex-direction: row; }
.mde-body.split-horizontal .mde-divider {
  width: 5px;
  height: 100%;
  cursor: col-resize;
}
.mde-body.split-horizontal .mde-pane-edit { flex: 1 1 50%; }
.mde-body.split-horizontal .mde-pane-preview { flex: 1 1 50%; }

/* 纵向分栏 */
.mde-body.split-vertical { flex-direction: column; }
.mde-body.split-vertical .mde-divider {
  width: 100%;
  height: 5px;
  cursor: row-resize;
}
.mde-body.split-vertical .mde-pane-edit { flex: 1 1 50%; overflow: hidden; }
.mde-body.split-vertical .mde-pane-preview { flex: 1 1 50%; overflow-y: auto; }

/* ========== 底部状态栏 ========== */
.mde-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 6px 12px;
  border: 1px solid var(--mde-border);
  border-top: none;
  border-radius: 0 0 var(--mde-radius) var(--mde-radius);
  background: var(--mde-bg-secondary);
  font-size: 12px;
  color: var(--mde-text-secondary);
}

/* ========== 预览区特殊样式 ========== */
#mde-preview .mermaid {
  margin: 1rem 0;
  text-align: center;
}

#mde-preview .katex-error {
  color: #ef4444;
  padding: 2px 6px;
  background: #fef2f2;
  border-radius: 3px;
  font-size: 0.9em;
}

.dark #mde-preview .katex-error {
  background: #451a1a;
}

/* 预览区代码块适配暗色模式 */
.dark #mde-preview pre code.hljs {
  background: #1e1e1e;
}

/* ========== 响应式 ========== */
@media (max-width: 768px) {
  .mde-body { flex-direction: column; height: auto; max-height: none; }
  .mde-pane-edit { min-height: 300px; }
  .mde-pane-preview { min-height: 300px; }
  .mde-divider { display: none !important; }
  .mde-body.view-split .mde-pane-edit,
  .mde-body.view-split .mde-pane-preview { flex: none; }
  .mde-actions-row { flex-direction: column; align-items: stretch; }
  .mde-actions-right { justify-content: flex-end; }
  .mde-toolbar { overflow-x: auto; flex-wrap: nowrap; }
}
</style>

<!-- ==================== JavaScript ==================== -->
<script is:inline>
(function () {
  "use strict";

  /* ==================================================================
   * 1. 状态
   * ================================================================*/
  let debounceTimer = null;
  const DEBOUNCE_MS = 300;
  let currentView = "split"; // split | edit | preview
  let splitDir = "horizontal"; // horizontal | vertical
  let isUpdating = false;

  /* ==================================================================
   * 2. DOM 引用
   * ================================================================*/
  const textarea = document.getElementById("mde-textarea");
  const preview = document.getElementById("mde-preview");
  const body = document.getElementById("mde-body");
  const divider = document.getElementById("mde-divider");
  const previewPane = document.getElementById("mde-pane-preview");
  const statsEl = document.getElementById("mde-stats");
  const statusEl = document.getElementById("mde-status");

  /* ==================================================================
   * 3. Mermaid 初始化
   * ================================================================*/
  if (window.mermaid) {
    mermaid.initialize({
      startOnLoad: false,
      theme: document.documentElement.classList.contains("dark") ? "dark" : "default",
      securityLevel: "loose",
    });
  }

  // 监听主题变化重新渲染 mermaid
  const themeObserver = new MutationObserver(() => {
    if (window.mermaid) {
      mermaid.initialize({
        startOnLoad: false,
        theme: document.documentElement.classList.contains("dark") ? "dark" : "default",
        securityLevel: "loose",
      });
    }
  });
  themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });

  /* ==================================================================
   * 4. 工具函数
   * ================================================================*/

  /** 在 textarea 中插入/wrap 文本 */
  function insertMarkdown(before, after, defaultText) {
    const ta = textarea;
    const start = ta.selectionStart;
    const end = ta.selectionEnd;
    const selected = ta.value.substring(start, end) || defaultText || "";
    const newText =
      ta.value.substring(0, start) + before + selected + after + ta.value.substring(end);
    ta.value = newText;
    // 恢复光标位置
    const cursorPos = start + before.length + selected.length + after.length;
    ta.focus();
    ta.setSelectionRange(
      selected ? start + before.length : cursorPos,
      selected ? start + before.length + selected.length : cursorPos
    );
    triggerUpdate();
  }

  /** 在光标处插入文本（新行） */
  function insertNewLine(text) {
    const ta = textarea;
    const start = ta.selectionStart;
    const beforeCursor = ta.value.substring(0, start);
    const afterCursor = ta.value.substring(ta.selectionEnd);
    // 确保前面是换行
    const prefix = beforeCursor.endsWith("\n") ? "" : "\n";
    const suffix = afterCursor.startsWith("\n") ? "" : "\n";
    ta.value = beforeCursor + prefix + text + suffix + afterCursor;
    const pos = start + prefix.length + text.length + suffix.length;
    ta.focus();
    ta.setSelectionRange(pos, pos);
    triggerUpdate();
  }

  /** 更新状态栏 */
  function updateStats() {
    const text = textarea.value;
    const wordCount = text.trim() ? text.trim().split(/\s+/).length : 0;
    const charCount = text.length;
    const lineCount = text.split("\n").length;
    statsEl.textContent = `字数: ${charCount} | 单词: ${wordCount} | 行数: ${lineCount}`;
  }

  /** 设置状态消息 */
  function setStatus(msg, isError) {
    statusEl.textContent = msg;
    statusEl.style.color = isError ? "#ef4444" : "";
  }

  /* ==================================================================
   * 5. Markdown 渲染管线
   * ================================================================*/

  /** 预提取：将特殊语法替换为占位符 */
  function preprocess(text) {
    const extractors = {
      mermaidBlocks: [],
      mathBlocks: [],
      mathInlines: [],
    };

    let processed = text;

    // 5a. Mermaid 代码块 (```mermaid ... ```)
    let mIdx = 0;
    processed = processed.replace(/```mermaid\s*\n?([\s\S]*?)```/g, (_, code) => {
      const id = `@@MDE_MERMAID_${mIdx}@@`;
      extractors.mermaidBlocks.push(code.trim());
      mIdx++;
      return id;
    });

    // 5b. 块级数学 $$...$$
    let mbIdx = 0;
    processed = processed.replace(/\$\$([\s\S]*?)\$\$/g, (_, formula) => {
      const id = `@@MDE_MATH_BLOCK_${mbIdx}@@`;
      extractors.mathBlocks.push(formula.trim());
      mbIdx++;
      return id;
    });

    // 5c. 行内数学 $...$（确保成对出现，且不含换行）
    let miIdx = 0;
    processed = processed.replace(/(?<!\$)\$([^\n$]+?)\$(?!\$)/g, (_, formula) => {
      const id = `@@MDE_MATH_INLINE_${miIdx}@@`;
      extractors.mathInlines.push(formula.trim());
      miIdx++;
      return id;
    });

    return { processed, extractors };
  }

  /** 后处理：将占位符替换为渲染后的 HTML */
  function postprocess(html, extractors) {
    let result = html;

    // 替换块级数学（使用正则 replace 全局匹配，避免重复公式只替换首个）
    extractors.mathBlocks.forEach((formula, i) => {
      try {
        const rendered = window.katex.renderToString(formula, {
          displayMode: true,
          throwOnError: false,
        });
        const re = new RegExp(escapeRegex(`@@MDE_MATH_BLOCK_${i}@@`), "g");
        result = result.replace(re, rendered);
      } catch (e) {
        const re = new RegExp(escapeRegex(`@@MDE_MATH_BLOCK_${i}@@`), "g");
        result = result.replace(
          re,
          `<div class="katex-error">公式错误: ${escapeHtml(formula)}</div>`
        );
      }
    });

    // 替换行内数学
    extractors.mathInlines.forEach((formula, i) => {
      try {
        const rendered = window.katex.renderToString(formula, {
          displayMode: false,
          throwOnError: false,
        });
        const re = new RegExp(escapeRegex(`@@MDE_MATH_INLINE_${i}@@`), "g");
        result = result.replace(re, rendered);
      } catch (e) {
        const re = new RegExp(escapeRegex(`@@MDE_MATH_INLINE_${i}@@`), "g");
        result = result.replace(
          re,
          `<span class="katex-error">${escapeHtml(formula)}</span>`
        );
      }
    });

    // 替换 Mermaid 占位符
    extractors.mermaidBlocks.forEach((code, i) => {
      const placeholder = `@@MDE_MERMAID_${i}@@`;
      const div = `<div class="mermaid">${escapeHtml(code)}</div>`;
      // 如果被 <p> 包裹，一并替换（全局匹配）
      const pPattern = new RegExp(`<p>${escapeRegex(placeholder)}<\\/p>`, "g");
      result = result.replace(pPattern, div);
      result = result.replace(new RegExp(escapeRegex(placeholder), "g"), div);
    });

    return result;
  }

  /** 转义 HTML */
  function escapeHtml(str) {
    const div = document.createElement("div");
    div.appendChild(document.createTextNode(str));
    return div.innerHTML;
  }

  /** 转义正则特殊字符 */
  function escapeRegex(str) {
    return str.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  }

  /** 将 callouts (GitHub 风格) 转为 HTML */
  function convertCallouts(html) {
    // GitHub / VitePress 风格 > [!NOTE]
    const calloutMap = {
      note: "bdm-note",
      tip: "bdm-tip",
      important: "bdm-important",
      warning: "bdm-warning",
      caution: "bdm-danger",
      danger: "bdm-danger",
    };

    // 匹配 blockquote 中的 callout 标记
    return html.replace(
      /<blockquote>\s*<p>\s*\[!(\w+)\]\s*(.*?)<\/p>([\s\S]*?)<\/blockquote>/gi,
      (_, type, title, rest) => {
        const cls = calloutMap[type.toLowerCase()] || "bdm-note";
        const displayType = type.charAt(0).toUpperCase() + type.slice(1).toLowerCase();
        return `<blockquote class="admonition ${cls}">
          <p class="bdm-title">${displayType}</p>
          <p>${title.trim()}</p>${rest}</blockquote>`;
      }
    );
  }

  /** 主要渲染函数 */
  function renderMarkdown(markdownText) {
    if (!window.marked) {
      return '<p style="color:#ef4444">⚠ marked 库未加载，请检查网络。</p>';
    }

    try {
      // 1. 预提取特殊语法
      const { processed, extractors } = preprocess(markdownText);

      // 2. 配置 marked
      window.marked.setOptions({
        breaks: true,
        gfm: true,
      });

      // 3. 解析为 HTML
      let html = window.marked.parse(processed);

      // 4. 后处理：替换特殊语法
      html = postprocess(html, extractors);

      // 5. 转换 callouts
      html = convertCallouts(html);

      return html;
    } catch (e) {
      console.error("Markdown 渲染错误:", e);
      return `<p style="color:#ef4444">渲染错误: ${e.message}</p>`;
    }
  }

  /** 应用语法高亮 */
  function applyHighlighting() {
    if (!window.hljs) return;
    try {
      preview.querySelectorAll("pre code[class*='language-']").forEach((block) => {
        // 跳过已经是高亮后的
        if (block.classList.contains("hljs")) return;
        hljs.highlightElement(block);
      });
    } catch (e) {
      console.warn("highlight 错误:", e);
    }
  }

  /** 渲染 Mermaid 图表 */
  async function renderMermaid() {
    if (!window.mermaid) return;
    try {
      const mermaidElements = previewPane.querySelectorAll(".mermaid");
      if (mermaidElements.length === 0) return;
      await mermaid.run({ nodes: Array.from(mermaidElements) });
    } catch (e) {
      console.warn("Mermaid 渲染错误:", e);
    }
  }

  /* ==================================================================
   * 6. 预览更新 & 光标定位
   * ================================================================*/

  /** 查找光标最近的章节标题文本 */
  function findSectionAtCursor() {
    const pos = textarea.selectionStart;
    const before = textarea.value.substring(0, pos);
    // 从后往前找最近的标题行
    const lines = before.split("\n");
    for (let i = lines.length - 1; i >= 0; i--) {
      const line = lines[i];
      const m = line.match(/^#{1,6}\s+(.+)$/);
      if (m) return m[1].trim();
    }
    return null;
  }

  /** 将预览滚动到指定标题位置 */
  function scrollToSection(headingText) {
    if (!headingText) {
      previewPane.scrollTop = 0;
      return;
    }
    const headings = preview.querySelectorAll("h1, h2, h3, h4, h5, h6");
    // 精确匹配
    for (const h of headings) {
      if (h.textContent.trim() === headingText) {
        h.scrollIntoView({ block: "start", behavior: "smooth" });
        return;
      }
    }
    // 模糊匹配（包含关系）
    for (const h of headings) {
      if (h.textContent.trim().includes(headingText) || headingText.includes(h.textContent.trim())) {
        h.scrollIntoView({ block: "start", behavior: "smooth" });
        return;
      }
    }
  }

  /** 更新预览 */
  function updatePreview() {
    if (isUpdating) return;
    isUpdating = true;
    setStatus("渲染中…");

    // 先记录光标所在的章节
    const section = findSectionAtCursor();

    try {
      const html = renderMarkdown(textarea.value);
      preview.innerHTML = html;

      // 后处理渲染
      applyHighlighting();
      renderMermaid().catch(() => {});

      // 渲染完成后滚动到光标对应章节
      requestAnimationFrame(() => scrollToSection(section));

      updateStats();
      setStatus("就绪");
    } catch (e) {
      setStatus("渲染出错", true);
      console.error(e);
    } finally {
      isUpdating = false;
    }
  }

  function triggerUpdate() {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(updatePreview, DEBOUNCE_MS);
  }

  /* ==================================================================
   * 7. 视图模式
   * ================================================================*/
  function setView(mode) {
    currentView = mode;
    // 保留分栏方向类
    body.className = "mde-body view-" + mode + " split-" + splitDir;
    document.querySelectorAll(".mde-view-tab").forEach((tab) => {
      tab.classList.toggle("active", tab.dataset.view === mode);
    });
    // 切换到预览时立刻刷新
    if (mode === "preview" || mode === "split") {
      updatePreview();
    }
  }

  /* ==================================================================
   * 7b. 分栏方向切换
   * ================================================================*/
  function setSplitDir(dir) {
    splitDir = dir;
    body.classList.remove("split-horizontal", "split-vertical");
    body.classList.add("split-" + dir);
    // 更新方向按钮图标
    const icon = document.getElementById("mde-dir-icon");
    if (dir === "horizontal") {
      icon.innerHTML = '<rect x="1" y="2" width="6" height="5" rx="1"/><rect x="1" y="9" width="6" height="5" rx="1"/><rect x="9" y="2" width="6" height="12" rx="1"/>';
    } else {
      icon.innerHTML = '<rect x="1" y="2" width="5" height="6" rx="1"/><rect x="8" y="2" width="5" height="6" rx="1"/><rect x="1" y="9" width="12" height="5" rx="1"/>';
    }
    // 重置拖拽大小
    const editPane = document.querySelector(".mde-pane-edit");
    const previewP = document.querySelector(".mde-pane-preview");
    if (editPane) { editPane.style.flex = ""; editPane.style.maxHeight = ""; }
    if (previewP) { previewP.style.flex = ""; previewP.style.maxHeight = ""; }
  }

  /* ==================================================================
   * 8. 下载
   * ================================================================*/
  function download(filename) {
    const content = textarea.value;
    if (!content.trim()) {
      setStatus("内容为空，无法下载", true);
      return;
    }
    const blob = new Blob([content], { type: "text/markdown;charset=utf-8" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    setStatus(`已下载 ${filename}`);
  }

  // 示例内容已移除（原 section 9）

  function clearEditor() {
    if (textarea.value.trim() && !confirm("确定要清空所有内容吗？")) return;
    textarea.value = "";
    preview.innerHTML = "";
    updateStats();
    setStatus("已清空");
  }

  /* ==================================================================
   * 10. 工具栏命令
   * ================================================================*/
  const toolbarCommands = {
    bold: () => insertMarkdown("**", "**", "粗体文本"),
    italic: () => insertMarkdown("*", "*", "斜体文本"),
    strike: () => insertMarkdown("~~", "~~", "删除线"),
    h1: () => insertNewLine("# 标题 1"),
    h2: () => insertNewLine("## 标题 2"),
    h3: () => insertNewLine("### 标题 3"),
    link: () => insertMarkdown("[", "](url)", "链接文本"),
    image: () => insertMarkdown("![", "](url)", "图片描述"),
    code: () => insertMarkdown("`", "`", "code"),
    codeblock: () => insertNewLine("```语言\n代码片段\n```"),
    mermaid: () => insertNewLine("```mermaid\ngraph TD\n    A[开始] --> B[结束]\n```"),
    blockquote: () => insertNewLine("> 引用文本"),
    ul: () => insertNewLine("- 列表项"),
    ol: () => insertNewLine("1. 列表项"),
    table: () =>
      insertNewLine(
        "| 列 1 | 列 2 | 列 3 |\n| --- | --- | --- |\n| 内容 | 内容 | 内容 |"
      ),
    hr: () => insertNewLine("---"),
    katex: () => insertMarkdown("$", "$", "E = mc^2"),
    admonition: () => insertNewLine("> [!NOTE]\n> 这是一个提示信息。"),
  };

  /* ==================================================================
   * 11. 键盘快捷键
   * ================================================================*/
  function handleKeyboard(e) {
    const isMac = navigator.userAgent.includes("Mac");
    const modKey = isMac ? e.metaKey : e.ctrlKey;

    if (modKey) {
      switch (e.key.toLowerCase()) {
        case "b":
          e.preventDefault();
          toolbarCommands.bold();
          break;
        case "i":
          e.preventDefault();
          toolbarCommands.italic();
          break;
        case "s":
          // Ctrl+S 触发下载 .md
          if (!e.shiftKey) {
            e.preventDefault();
            download("article.md");
          }
          break;
      }
    }
  }

  /* ==================================================================
   * 12. 初始化
   * ================================================================*/
  function init() {
    // 初始化状态（空编辑器）
    textarea.value = "";
    textarea.placeholder = "";

    // 工具栏按钮事件
    document.querySelectorAll(".mde-btn[data-cmd]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const cmd = btn.dataset.cmd;
        if (toolbarCommands[cmd]) toolbarCommands[cmd]();
        // 插入格式后延迟滚动到光标对应段落
        setTimeout(() => {
          const section = findSectionAtCursor();
          if (section) scrollToSection(section);
        }, 400);
      });
    });

    // 视图切换
    document.querySelectorAll(".mde-view-tab").forEach((tab) => {
      tab.addEventListener("click", () => setView(tab.dataset.view));
    });

    // 分栏方向切换
    document.getElementById("mde-dir-toggle").addEventListener("click", () => {
      const newDir = splitDir === "horizontal" ? "vertical" : "horizontal";
      setSplitDir(newDir);
    });

    // 操作按钮
    // 示例按钮事件已移除
    document.getElementById("mde-clear-btn").addEventListener("click", clearEditor);
    document.getElementById("mde-download-md").addEventListener("click", () => download("article.md"));
    document.getElementById("mde-download-mdx").addEventListener("click", () => download("article.mdx"));

    // 编辑器输入事件
    textarea.addEventListener("input", () => {
      triggerUpdate();
      if (!isUpdating) updateStats();
    });

    // 键盘快捷键
    textarea.addEventListener("keydown", handleKeyboard);

    // 拖拽分割线（支持横向和纵向）
    let isDragging = false;
    let dragAxis = "x"; // x = horizontal, y = vertical

    divider.addEventListener("mousedown", () => {
      if (currentView !== "split") return;
      isDragging = true;
      dragAxis = splitDir === "horizontal" ? "x" : "y";
      document.body.style.cursor = splitDir === "horizontal" ? "col-resize" : "row-resize";
      document.body.style.userSelect = "none";
    });

    document.addEventListener("mousemove", (e) => {
      if (!isDragging) return;
      const bodyRect = body.getBoundingClientRect();

      if (dragAxis === "x") {
        const offset = e.clientX - bodyRect.left;
        const pct = Math.max(20, Math.min(80, (offset / bodyRect.width) * 100));
        document.querySelector(".mde-pane-edit").style.flex = "1 1 " + pct + "%";
        document.querySelector(".mde-pane-preview").style.flex = "1 1 " + (100 - pct) + "%";
      } else {
        const offset = e.clientY - bodyRect.top;
        const pct = Math.max(20, Math.min(80, (offset / bodyRect.height) * 100));
        const editPane = document.querySelector(".mde-pane-edit");
        const previewP = document.querySelector(".mde-pane-preview");
        if (editPane) editPane.style.flex = "1 1 " + pct + "%";
        if (previewP) previewP.style.flex = "1 1 " + (100 - pct) + "%";
      }
    });

    document.addEventListener("mouseup", () => {
      if (isDragging) {
        isDragging = false;
        document.body.style.cursor = "";
        document.body.style.userSelect = "";
      }
    });

    // 防止鼠标离开编辑器区域时拖拽状态卡死
    document.addEventListener("mouseleave", () => {
      if (isDragging) {
        isDragging = false;
        document.body.style.cursor = "";
        document.body.style.userSelect = "";
      }
    });

    // 初始渲染
    setSplitDir("horizontal");
    setView("split");
    updatePreview();
    updateStats();

    console.log("🔥 Markdown Editor 已初始化");
  }

  // 等 DOM 就绪
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }

  // 示例内容已移除（原 section 13，约 200 行）
})();
</script>
